+PROFILE = Path.home() / ".config" / "brutalist" / "profile.json"
+
+def resolve_handle(meta):
+    """The author's on-screen handle, shown on every frame of every cut.
+    metadata.handle wins ("none" turns it off for one reel); then $ART_HANDLE;
+    then ~/.config/brutalist/profile.json {"handle": "@Name"}, so every video
+    an author makes carries their name without touching each beat sheet."""
+    h = meta.get("handle")
+    if h is None:
+        h = os.environ.get("ART_HANDLE", "").strip() or None
+    if h is None and PROFILE.is_file():
+        try:
+            h = json.loads(PROFILE.read_text()).get("handle")
+        except (OSError, ValueError):
+            h = None
+    h = (h or "").strip()
+    return "" if h.lower() == "none" else h
+
+def make_handle_png(out, text, font_path, size):
+    """Cream text on an ink pill: readable on cream, dark and photographic
+    beats alike (12:1 contrast), so one chip works across the whole reel."""
+    from PIL import Image, ImageDraw
+    f = _pil_font(font_path, size)
+    tw = ImageDraw.Draw(Image.new("RGBA", (4, 4))).textbbox((0, 0), text, font=f)
+    pad_x, pad_y = int(size * 0.62), int(size * 0.38)
+    img_w, img_h = tw[2] - tw[0] + pad_x * 2, tw[3] - tw[1] + pad_y * 2
+    img = Image.new("RGBA", (img_w, img_h), (0, 0, 0, 0))
+    d = ImageDraw.Draw(img)
+    d.rounded_rectangle((0, 0, img_w - 1, img_h - 1), radius=img_h // 2, fill=(*INK_RGB, 235))
+    d.text((pad_x - tw[0], pad_y - tw[1]), text, font=f, fill=(*CREAM_RGB, 255))
+    img.save(out)
+
