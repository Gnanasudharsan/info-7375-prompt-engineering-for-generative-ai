diff --git a/runtime/scripts/hyperframes_scenes.py b/runtime/scripts/hyperframes_scenes.py
new file mode 100644
index 0000000..5bd4dfd
--- /dev/null
+++ b/runtime/scripts/hyperframes_scenes.py
@@ -0,0 +1,114 @@
+#!/usr/bin/env python3
+"""hyperframes_scenes.py — fill beats with HyperFrames (HTML + GSAP) compositions.
+
+A beat opts in with `shot.hyperframes.composition`: a folder (relative to the reel) holding a
+HyperFrames project (index.html with data-composition-id, assets/gsap.min.js). Each is rendered
+to `media/<BID>.mp4`, the slot compile.py already reads, and its duration is checked against the
+beat's actual_duration_s (the narration is the clock). Provenance goes to shot.hyperframes.rendered.
+
+Usage:
+  python3 scripts/hyperframes_scenes.py <REEL> [--only B04] [--force] [--quality draft|standard|high]
+
+CLI: $HYPERFRAMES_BIN, else ~/Desktop/Nate_Herk/herk-edit-kit/node_modules/.bin/hyperframes,
+else `npx hyperframes` (needs Node >= 22 and FFmpeg; `hyperframes doctor` checks both).
+"""
+import argparse, json, os, shutil, subprocess, sys
+from datetime import datetime, timezone
+from pathlib import Path
+
+KIT_BIN = Path.home() / "Desktop/Nate_Herk/herk-edit-kit/node_modules/.bin/hyperframes"
+FRAME_TOLERANCE = 2
+
+
+def hf_cmd():
+    env = os.environ.get("HYPERFRAMES_BIN", "").strip()
+    if env:
+        return [env]
+    if KIT_BIN.exists():
+        return [str(KIT_BIN)]
+    if shutil.which("hyperframes"):
+        return ["hyperframes"]
+    return ["npx", "--yes", "hyperframes"]
+
+
+def probe(path):
+    out = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration",
+                          "-of", "csv=p=0", str(path)], capture_output=True, text=True).stdout.strip()
+    return float(out) if out else 0.0
+
+
+def hf_beats(sheet):
+    return [b for b in sheet.get("beats", []) if ((b.get("shot") or {}).get("hyperframes") or {}).get("composition")]
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("reel", type=Path)
+    ap.add_argument("--only")
+    ap.add_argument("--force", action="store_true")
+    ap.add_argument("--quality", default="high", choices=("draft", "standard", "high"))
+    ap.add_argument("--sheet", default="beat_sheet.json")
+    a = ap.parse_args()
+
+    reel = a.reel.resolve()
+    sheet_path = reel / a.sheet
+    sheet = json.loads(sheet_path.read_text())
+    fps = int(sheet.get("metadata", {}).get("fps", 24))
+    beats = hf_beats(sheet)
+    if a.only:
+        beats = [b for b in beats if b["beat_id"] in a.only.split(",")]
+    if not beats:
+        print("[hyperframes] no beats with shot.hyperframes.composition")
+        return 0
+
+    (reel / "media").mkdir(exist_ok=True)
+    failed, stamps = [], {}
+    for b in beats:
+        bid = b["beat_id"]
+        comp = reel / b["shot"]["hyperframes"]["composition"]
+        out = reel / "media" / f"{bid}.mp4"
+        if out.exists() and not a.force:
+            print(f"[hyperframes] {bid}: media/{bid}.mp4 exists (use --force to re-render)")
+            continue
+        if not (comp / "index.html").exists():
+            print(f"[hyperframes] {bid}: missing {comp}/index.html", file=sys.stderr)
+            failed.append(bid)
+            continue
+        lint = subprocess.run(hf_cmd() + ["lint", str(comp)], capture_output=True, text=True)
+        if lint.returncode != 0 or " 0 errors" not in lint.stdout:
+            print(f"[hyperframes] {bid}: lint failed\n{lint.stdout[-1500:]}", file=sys.stderr)
+            failed.append(bid)
+            continue
+        tmp = out.with_suffix(".tmp.mp4")
+        r = subprocess.run(hf_cmd() + ["render", str(comp), "--output", str(tmp), "--fps", str(fps),
+                                       "--quality", a.quality], capture_output=True, text=True)
+        if r.returncode != 0 or not tmp.exists():
+            print(f"[hyperframes] {bid}: render failed\n{(r.stdout + r.stderr)[-1500:]}", file=sys.stderr)
+            failed.append(bid)
+            continue
+        got, want = probe(tmp), float(b.get("actual_duration_s") or b.get("estimated_duration_s") or 0)
+        if want and abs(got - want) * fps > FRAME_TOLERANCE:
+            print(f"[hyperframes] {bid}: rendered {got:.2f}s but the narration is {want:.2f}s; "
+                  f"set data-duration to actual_duration_s", file=sys.stderr)
+            tmp.unlink()
+            failed.append(bid)
+            continue
+        os.replace(tmp, out)
+        stamps[bid] = {"out": f"media/{bid}.mp4", "seconds": round(got, 3), "quality": a.quality,
+                       "at": datetime.now(timezone.utc).isoformat()}
+        print(f"[hyperframes] {bid}: media/{bid}.mp4 {got:.2f}s")
+
+    # Re-read before writing: other renderers (remotion_scenes.py) stamp the same sheet.
+    latest = json.loads(sheet_path.read_text())
+    for lb in latest.get("beats", []):
+        if lb["beat_id"] in stamps:
+            lb["shot"]["hyperframes"]["rendered"] = stamps[lb["beat_id"]]
+    sheet_path.write_text(json.dumps(latest, indent=2, ensure_ascii=False) + "\n")
+    if failed:
+        print(f"[hyperframes] FAILED: {', '.join(failed)}", file=sys.stderr)
+        return 2
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
