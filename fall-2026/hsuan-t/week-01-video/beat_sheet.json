    {
      "beat_id": "B08",
      "act": "demo — the reveal",
      "narration_text": "Now put a single space in front of it, the way it actually appears mid-sentence. Eleven characters — and the tokenizer no longer splits it at all. The whole word collapses into one opaque token.",
      "voice": "am_puck",
      "engine": "kokoro",
