        "src": "media/B13.mp4",
        "filled_by": "media",
        "at": "2026-09-27T23:51:12"
      }
    },
    {
      "beat_id": "B14",
      "act": "recap",
      "narration_text": "So: the unit is a token, not a word. Whenever a task lives at the letter level — counting, reversing, spelling — assume the model can't see it directly, and hand that part to something that can.",
      "voice": "am_puck",
      "engine": "kokoro",
      "estimated_duration_s": 11,
