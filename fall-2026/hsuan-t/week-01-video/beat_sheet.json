            "at": "2026-09-28T02:05:58.703887+00:00"
          }
        }
      }
    },
    {
      "beat_id": "B06",
      "act": "demo intro",
      "narration_text": "Let's not take my word for it. This is the real tokenizer GPT-4 uses, cl100k base, and I'm running it live against the exact word from the question.",
      "voice": "am_puck",
      "engine": "kokoro",
      "estimated_duration_s": 10,
      "shot": {
        "remotion": {
          "pattern": "ClaudeCodeBeat",
          "props": {
            "title": "tokenize.py",
            "language": "python",
            "code": "import tiktoken\nenc = tiktoken.get_encoding(\"cl100k_base\")\n\nfor w in [\"strawberry\", \" strawberry\"]:\n    ids = enc.encode(w)\n    print(w, \"->\", [enc.decode([i]) for i in ids])",
            "sparkLine": "No screenshots — this actually ran."
          },
          "rendered": {
            "out": "media/B06.mp4",
            "at": "2026-09-28T02:06:33.136616+00:00"
          }
        }
