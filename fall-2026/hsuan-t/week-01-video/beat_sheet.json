  "beats": [
    {
      "beat_id": "B00",
      "act": "cold open",
      "narration_text": "Konnichiwa — this is Isaac from Taiwan. Ask a language model to count the r's in strawberry, and it will probably get it wrong. Not because it's dumb — because of what it's actually reading. Let's find out what that is.",
      "voice": "am_puck",
      "engine": "kokoro",
      "estimated_duration_s": 13,
      "shot": {
        "remotion": {
          "pattern": "ClaudeComposerAsk",
          "props": {
            "greeting": "Konnichiwa, Isaac",
            "topic": "TOKENIZATION",
            "segment": "The Unit Is a Token, Not a Word.",
            "command": "Why does an LLM get 'how many r's in strawberry' wrong?",
            "runningText": "loading tokenizer…",
            "output": [
              "The model never reads letters.",
              "It reads tokens — and 'strawberry' isn't one."
            ],
            "folderLabel": "@NikBearBrown"
          },
          "rendered": {
            "out": "media/B00.mp4",
            "at": "2026-09-28T02:03:15.667725+00:00"
          }
        }
      },
      "actual_duration_s": 13.08,
      "audio_file": "mp3/beat-B00.mp3",
      "render_duration_s": 13.083333333333334,
      "build": {
        "status": "VIDEO",
        "src": "media/B00.mp4",
        "filled_by": "remotion:ClaudeComposerAsk",
        "at": "2026-09-27T23:51:12"
      }
