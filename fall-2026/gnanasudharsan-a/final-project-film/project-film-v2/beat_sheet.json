        "filled_by": "media",
        "at": "2026-11-22T13:38:07"
      }
    },
    {
      "beat_id": "B08",
      "act": "chatgpt",
      "script_lines": [
        "L15"
      ],
      "narration_text": "ChatGPT got the status right, but it dated that status to an unrelated team retrospective, and nothing flagged it.",
