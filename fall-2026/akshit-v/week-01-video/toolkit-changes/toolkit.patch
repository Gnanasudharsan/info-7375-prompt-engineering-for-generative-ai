+      {limits.map((l, i) => {
+        const o = rv(c(lk[i], lf[i]));
+        return (
+          <div key={i} style={{ position: 'absolute', left: SAFE.x + 90, top: 262 + i * 152 + (1 - o) * 24, width: SAFE.w - 180,
+            opacity: o, background: '#FFFFFF', border: `1px solid ${CLAUDE.BORDER}`,
+            borderLeft: `10px solid ${CLAUDE.INK_SOFT}`, borderRadius: 12, padding: '20px 28px' }}>
+            <div style={{ fontFamily: SERIF, fontSize: 38, color: CLAUDE.INK }}>{l[0]}</div>
+            <div style={{ fontFamily: SANS, fontSize: 24, color: CLAUDE.INK_SOFT, marginTop: 8 }}>{l[1]}</div>
+          </div>
+        );
+      })}
+      <div style={{ position: 'absolute', left: SAFE.x + 90, top: 770 + (1 - keep) * 20, width: SAFE.w - 180, opacity: keep,
+        background: '#FFFFFF', border: `2px solid ${CLAUDE.SPARK}`, borderRadius: 12, padding: '18px 28px', textAlign: 'center' }}>
+        <div style={{ fontFamily: SANS, fontSize: 22, color: CLAUDE.SPARK, letterSpacing: 1 }}>WHAT SURVIVES</div>
+        <div style={{ fontFamily: SERIF, fontSize: 42, color: CLAUDE.INK, marginTop: 6 }}>truth was never the target</div>
+      </div>
+      <BrandBug label={folderLabel} />
+    </IlluStage>
+  );
+};
+
+/* ==================================================================== *
+ * SubmissionOutro (B11) — author credit for a student submission.       *
+ *   Deliberately NOT ClaudeTitleOutro, which hardcodes @NikBearBrown.   *
+ * ==================================================================== */
+export const SubmissionOutro: React.FC<{
+  title: string; thesis: string; creditLead?: string; author: string; course: string; week: string; cues?: Cues;
+}> = ({ title, thesis, creditLead = 'a video created by', author, course, week, cues }) => {
+  const c = cueOf(cues); const rv = useReveal();
+  const t = rv(c('title', 0.04), 0.7), th = rv(c('thesis', 0.16), 0.7);
+  const cr = rv(c('credit', 0.40), 0.7), co = rv(c('course', 0.53), 0.7), wk = rv(c('week', 0.75), 0.7);
+  return (
+    <IlluStage spark="" sparkPos="top">
+      <Center y={236 + (1 - t) * 20} o={t} size={92} font={SERIF} color={CLAUDE.INK}>{title}</Center>
+      <Center y={370} o={th} size={48} font={SERIF} color={CLAUDE.SPARK}>{thesis}</Center>
+      <div style={{ position: 'absolute', left: SAFE.x + 360, top: 478, width: SAFE.w - 720, height: 2, background: CLAUDE.BORDER, opacity: cr }} />
+      <Center y={510} o={cr} size={28}>{creditLead}</Center>
+      <Center y={552} o={cr} size={60} font={SERIF} color={CLAUDE.INK}>{author}</Center>
+      <Center y={654} o={co} size={34} color={CLAUDE.INK}>{course}</Center>
+      <Center y={708} o={wk} size={28}>{week}</Center>
+      <Center y={800} o={wk} size={24}>narration: synthetic voice (Kokoro am_onyx), not the author · built with the brutalist.art toolkit</Center>
+    </IlluStage>
+  );
+};
+
+/* ==================================================================== *
+ * ReconstructedComposer (B00, B10) — the toolkit's Claude composer,     *
+ *   LABELLED as reconstructed UI.                                        *
+ * -------------------------------------------------------------------- *
+ * The assignment: "If you show a Claude response, it must be a real one *
+ * you actually got, with the date." The course video guide: "label     *
+ * fixtures and reconstructed UI." Nothing in these beats was sent to or  *
+ * returned by Claude, so: no reply lines, no model chip, and a visible   *
+ * tag saying what the viewer is looking at.                              *
+ * ==================================================================== */
+export const ReconstructedComposer: React.FC<{
+  command: string; topic: string; segment: string; greeting: string; folderLabel: string;
+  tagLines: string[]; durationSeconds?: number;
+}> = ({ command, topic, segment, greeting, folderLabel, tagLines }) => {
+  const rv = useReveal(); const o = rv(0.02, 0.6);
+  return (
+    <AbsoluteFill>
+      <ClaudeComposerAsk command={command} topic={topic} segment={segment} greeting={greeting}
+        runningText="" output={[]} folderLabel={folderLabel} modelLabel="" effortLabel=""
+        placeholder="" />
+      <div style={{ position: 'absolute', right: 1920 - SAFE.r, top: SAFE.y + 6, maxWidth: 700, opacity: o,
+        border: `2px solid ${CLAUDE.SPARK}`, borderRadius: 10, padding: '12px 20px', background: '#FFFFFF' }}>
+        <div style={{ fontFamily: SANS, fontSize: 22, fontWeight: 700, color: CLAUDE.SPARK, letterSpacing: 1 }}>RECONSTRUCTED UI</div>
+        {tagLines.map((t, i) => (
+          <div key={i} style={{ fontFamily: SANS, fontSize: 21, color: CLAUDE.INK, marginTop: 4, lineHeight: 1.3 }}>{t}</div>
+        ))}
+      </div>
+    </AbsoluteFill>
+  );
+};
