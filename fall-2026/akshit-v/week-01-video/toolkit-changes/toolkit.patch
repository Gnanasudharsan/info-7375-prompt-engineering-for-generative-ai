+/**
+ * illustrations/molecular.tsx — the MOLECULAR illustration family.
+ *
+ * WHY THIS FILE EXISTS
+ * --------------------
+ * GATE L (library-first) was run for "ribosome reading mRNA codons building
+ * protein chain" before a single beat of `claude-liam-how-ribosomes-read-mrna`
+ * was authored. It returned 8 leads, all of them METAPHORICAL chains from
+ * unrelated reels (BrandB01ChainFailure, GitHubCallChain, SourcedLaundering…).
+ * Nothing in the library could show a tape being read in triplets. That is a
+ * genuine PUNT, and a punt is a design card — so these components were built
+ * here, parameterized, so the next molecular reel finds them forever.
+ *
+ * CANVAS NOTE (differs from structural.tsx on purpose)
+ * ----------------------------------------------------
+ * structural.tsx assumes a 1280×720 stage. These are authored NATIVELY at
+ * 1920×1080 and positioned from the shared SAFE inset (x 96–1824, y 54–1026),
+ * because FILL-THE-CANVAS LAW and the Gate-V title-safe audit both speak in
+ * 1920×1080 units. Geometry here is in those units; do not rescale it.
+ *
+ * LAWS KEPT (same as every illustration in this folder)
+ *  • Pure function of useP() — no CSS transitions, no timers, no random().
+ *  • ONE terracotta accent (CLAUDE.SPARK) per beat: the MATCH. Everything that
+ *    is merely present is ink; the thing that just locked is terracotta.
+ *  • Wrapped in <IlluStage spark="…"> so the spark-line law is satisfied.
+ *  • LOGO LAW: <BrandBug> puts the channel handle lower-right inside SAFE.
+ *
+ * THE BIOLOGY IS CHECKED, NOT DECORATIVE
+ * --------------------------------------
+ * The default tape AUGGCUUCAGAUCCGAAUUAG reads
+ *   AUG GCU UCA GAU CCG AAU UAG  →  Met Ala Ser Asp Pro Asn STOP
+ * and deleting base index 7 ('C') reframes it to
+ *   AUG GCU UAG                  →  Met Ala STOP   (premature stop)
+ * Both were computed against the standard genetic code before this file was
+ * written; see the reel's SOURCES.md. CODON_TABLE below is the real table —
+ * 64 codons, 21 distinct products. Do not hand-edit a letter of it.
+ *
+ * HOW TO ADAPT: change the props (tape, phase, deleteAt, labels). If you need
+ * different motion, you are building a new component — add it here.
+ */
+import React from 'react';
+import { CLAUDE } from '../tokens/claude';
+import { SAFE } from '../tokens/layout';
+import { SERIF, SANS, MONO, clamp, remap, ease, useP, IlluStage } from './kit';
+import { LayerStack, Layer } from './structural';
+
+/* The standard genetic code, RNA alphabet, ordered UCAG × UCAG × UCAG. */
+const BASES = 'UCAG';
+const AA_STRING =
+  'FFLLSSSSYY**CC*WLLLLPPPPHHQQRRRRIIIMTTTTNNKKSSRRVVVVAAAADDEEGGGG';
+export const CODON_TABLE: Record<string, string> = (() => {
+  const t: Record<string, string> = {};
+  let i = 0;
+  for (const a of BASES) for (const b of BASES) for (const c of BASES) t[a + b + c] = AA_STRING[i++];
+  return t;
+})();
+const AA_NAME: Record<string, string> = {
+  F: 'Phe', L: 'Leu', S: 'Ser', Y: 'Tyr', C: 'Cys', W: 'Trp', P: 'Pro', H: 'His',
+  Q: 'Gln', R: 'Arg', I: 'Ile', M: 'Met', T: 'Thr', N: 'Asn', K: 'Lys', V: 'Val',
+  A: 'Ala', D: 'Asp', E: 'Glu', G: 'Gly', '*': 'STOP',
+};
+const COMPLEMENT: Record<string, string> = { A: 'U', U: 'A', G: 'C', C: 'G' };
+const anticodon = (c: string) => c.split('').map((b) => COMPLEMENT[b]).join('');
+
+/* ── shared geometry (1920×1080) ─────────────────────────────────────── */
+const CELL = 58;          // letter pitch along the tape
+const TAPE_Y = 660;       // tape baseline
+const BODY_W = CELL * 9;  // the ribosome covers E, P and A = 9 bases
+const BODY_H = 250;
+// The body sits ABOVE the tape and clamps it — it must never cover the letters
+// it is reading. Bottom edge lands 18px clear of the glyph tops. (QC 2026-09-26:
+// the first cut drew the body over the tape and hid the middle of the sequence.)
+const BODY_TOP = TAPE_Y - BODY_H - 18;
+
+const tapeStartX = (n: number) => Math.round((1920 - n * CELL) / 2);
+const triplets = (s: string) => {
+  const out: string[] = [];
+  for (let i = 0; i + 2 < s.length; i += 3) out.push(s.slice(i, i + 3));
+  return out;
+};
+
+/** LOGO LAW — channel handle as a low-opacity wordmark, lower-right, inside SAFE. */
+export const BrandBug: React.FC<{ label?: string }> = ({ label }) =>
+  label ? (
+    <div style={{
+      position: 'absolute', right: 1920 - SAFE.r, bottom: 1080 - SAFE.b,
+      fontFamily: SERIF, fontSize: 26, color: CLAUDE.INK, opacity: 0.28, letterSpacing: 0.5,
+    }}>{label}</div>
+  ) : null;
+
+/* ── small shared parts ──────────────────────────────────────────────── */
+
+const Letter: React.FC<{ ch: string; x: number; y: number; on: number; accent?: boolean; dim?: boolean }> =
+  ({ ch, x, y, on, accent, dim }) => (
+    <div style={{
+      position: 'absolute', left: x, top: y, width: CELL, textAlign: 'center',
+      fontFamily: MONO, fontSize: 46, fontWeight: 600,
+      color: accent ? CLAUDE.SPARK : CLAUDE.INK,
+      opacity: on * (dim ? 0.28 : 1),
+    }}>{ch}</div>
+  );
+
+/** The tape: a run of bases with a hairline rule under it. */
+const Tape: React.FC<{ tape: string; reveal: number; accentRange?: [number, number]; dimFrom?: number }> =
+  ({ tape, reveal, accentRange, dimFrom }) => {
+    const x0 = tapeStartX(tape.length);
+    return (
+      <>
+        <div style={{
+          position: 'absolute', left: x0, top: TAPE_Y + 62, height: 2,
+          width: tape.length * CELL * clamp(reveal * 1.1, 0, 1), background: CLAUDE.BORDER,
+        }} />
+        {tape.split('').map((ch, i) => {
+          const on = clamp(reveal * tape.length - i, 0, 1);
+          const acc = !!accentRange && i >= accentRange[0] && i <= accentRange[1];
+          return <Letter key={i} ch={ch} x={x0 + i * CELL} y={TAPE_Y} on={on} accent={acc}
+            dim={dimFrom !== undefined && i >= dimFrom} />;
+        })}
+      </>
+    );
+  };
+
+/** A codon window: the box that marks what the reader currently holds. */
+const Window: React.FC<{ startIdx: number; n: number; tapeLen: number; o: number; accent?: boolean; label?: string }> =
+  ({ startIdx, n, tapeLen, o, accent, label }) => {
+    const x0 = tapeStartX(tapeLen) + startIdx * CELL;
+    return (
+      <>
+        <div style={{
+          position: 'absolute', left: x0 - 6, top: TAPE_Y - 12, width: n * CELL + 12, height: 78,
+          border: `3px solid ${accent ? CLAUDE.SPARK : CLAUDE.INK}`, borderRadius: 10, opacity: o,
+        }} />
+        {label && (
+          <div style={{
+            position: 'absolute', left: x0 - 60, top: TAPE_Y + 86, width: n * CELL + 120, textAlign: 'center',
+            fontFamily: SANS, fontSize: 24, color: accent ? CLAUDE.SPARK : CLAUDE.INK_SOFT, opacity: o,
+          }}>{label}</div>
+        )}
+      </>
+    );
+  };
+
+/** The ribosome body with its three slots. */
+const Body: React.FC<{ centerX: number; o: number; slots?: boolean; emptyA?: number }> =
+  ({ centerX, o, slots, emptyA = 0 }) => (
+    <>
+      <div style={{
+        position: 'absolute', left: centerX - BODY_W / 2, top: BODY_TOP,
+        width: BODY_W, height: BODY_H, background: '#FFFFFF',
+        border: `2px solid ${CLAUDE.BORDER}`, borderRadius: 28,
+        boxShadow: '0 10px 30px rgba(61,57,41,0.10)', opacity: o,
+      }} />
+      {slots && ['E', 'P', 'A'].map((s, i) => {
+        const sx = centerX - BODY_W / 2 + i * (BODY_W / 3);
+        const isA = s === 'A';
+        return (
+          <div key={s} style={{
+            position: 'absolute', left: sx, top: BODY_TOP, width: BODY_W / 3, height: BODY_H,
+            borderLeft: i ? `1px dashed ${CLAUDE.BORDER}` : 'none', opacity: o,
+            display: 'flex', alignItems: 'flex-end', justifyContent: 'center', paddingBottom: 14,
+            fontFamily: SANS, fontSize: 30, fontWeight: 700,
+            color: isA && emptyA > 0 ? CLAUDE.SPARK : CLAUDE.INK_SOFT,
+          }}>{s}</div>
+        );
+      })}
+    </>
+  );
+
+/** The growing peptide chain — beads above the body. */
+const Chain: React.FC<{ aas: string[]; grown: number; centerX: number; folded?: number }> =
+  ({ aas, grown, centerX, folded = 0 }) => {
+    const n = Math.floor(grown * aas.length);
+    return (
+      <>
+        {aas.slice(0, Math.max(0, n)).map((a, i) => {
+          const curl = folded * 26;
+          const x = centerX - 150 + i * 62 - curl * i * 0.5;
+          const y = BODY_TOP - 86 - (folded ? Math.sin(i * 1.1) * curl : 0);
+          return (
+            <div key={i} style={{
+              position: 'absolute', left: x, top: y, width: 54, height: 54, borderRadius: 27,
+              background: '#FFFFFF', border: `2px solid ${CLAUDE.INK}`,
+              display: 'flex', alignItems: 'center', justifyContent: 'center',
+              fontFamily: SANS, fontSize: 19, fontWeight: 700, color: CLAUDE.INK,
+            }}>{AA_NAME[a] ?? a}</div>
+          );
+        })}
+      </>
+    );
+  };
+
+/** A tRNA adapter: anticodon end + cargo end. */
+const Adapter: React.FC<{ x: number; y: number; codon: string; o: number; accent?: boolean; spent?: boolean }> =
+  ({ x, y, codon, o, accent, spent }) => (
+    <div style={{ position: 'absolute', left: x, top: y, opacity: o }}>
+      <div style={{
+        width: 186, height: 96, border: `3px solid ${accent ? CLAUDE.SPARK : CLAUDE.INK}`,
+        borderRadius: '14px 14px 46px 46px', background: '#FFFFFF',
+        display: 'flex', alignItems: 'center', justifyContent: 'center',
+        fontFamily: MONO, fontSize: 32, fontWeight: 700, color: accent ? CLAUDE.SPARK : CLAUDE.INK,
+      }}>{anticodon(codon)}</div>
+      {!spent && (
+        <div style={{
+          position: 'absolute', left: 66, top: -62, width: 54, height: 54, borderRadius: 27,
+          background: '#FFFFFF', border: `2px solid ${CLAUDE.INK}`,
+          display: 'flex', alignItems: 'center', justifyContent: 'center',
+          fontFamily: SANS, fontSize: 19, fontWeight: 700, color: CLAUDE.INK,
+        }}>{AA_NAME[CODON_TABLE[codon]] ?? '—'}</div>
+      )}
+    </div>
+  );
+
+const Note: React.FC<{ text: string; o: number; y?: number; accent?: boolean; strike?: boolean }> =
+  ({ text, o, y = 250, accent, strike }) => (
+    <div style={{
+      position: 'absolute', left: SAFE.x, top: y, width: SAFE.w, textAlign: 'center',
+      fontFamily: SANS, fontSize: 34, color: accent ? CLAUDE.SPARK : CLAUDE.INK_SOFT, opacity: o,
+      textDecoration: strike ? 'line-through' : 'none',
+    }}>{text}</div>
+  );
+
+/* ==================================================================== *
+ * RibosomeTape — the reading machine, in five phases.                   *
+ * -------------------------------------------------------------------- *
+ * WHEN: the beat is about the MECHANISM of translation.                 *
+ * PROPS:                                                                *
+ *   phase  'frame'       tape + reader clamps; one letter rejected,     *
+ *                        three accepted; the reader steps.              *
+ *          'adapter'     one codon + its tRNA, both ends labelled.      *
+ *          'cycle'       A/P/E worked example: mismatch bounces, match  *
+ *                        docks, bond transfers, spent adapter exits.    *
+ *          'translocate' the +3 ratchet; +2/+4 struck out; chain grows. *
+ *          'startstop'   AUG sets the frame; UAG leaves A empty; a      *
+ *                        release factor takes the slot; chain detaches. *
+ *   tape   the mRNA string (default reads Met-Ala-Ser-Asp-Pro-Asn-STOP) *
+ * ADAPT: change tape/phase. The accent is always the MATCH.             *
+ * ==================================================================== */
+export const RibosomeTape: React.FC<{
+  phase: 'frame' | 'adapter' | 'cycle' | 'translocate' | 'startstop';
+  tape?: string; spark?: string; folderLabel?: string;
+}> = ({ phase, tape = 'AUGGCUUCAGAUCCGAAUUAG', spark = '', folderLabel }) => {
+  const p = useP();
+  const codons = triplets(tape);
+  const aas = codons.map((c) => CODON_TABLE[c]).filter((a) => a !== '*');
+  const cx = 1920 / 2;
+
+  let inner: React.ReactNode = null;
+
+  if (phase === 'frame') {
+    const reveal = ease(remap(p, 0.02, 0.30, 0, 1));
+    const bodyO = ease(remap(p, 0.30, 0.46, 0, 1));
+    const oneO = remap(p, 0.50, 0.56, 0, 1) * (1 - remap(p, 0.64, 0.70, 0, 1));
+    const threeO = ease(remap(p, 0.68, 0.78, 0, 1));
+    const step = Math.floor(remap(p, 0.86, 0.98, 0, 1.999));
+    inner = (
+      <>
+        <Tape tape={tape} reveal={reveal} accentRange={threeO > 0.5 ? [step * 3, step * 3 + 2] : undefined} />
+        <Body centerX={cx} o={bodyO} />
+        <Window startIdx={4} n={1} tapeLen={tape.length} o={oneO} label="one letter?" />
+        <Note text="one letter" o={oneO} strike />
+        <Window startIdx={step * 3} n={3} tapeLen={tape.length} o={threeO} accent label="one codon" />
+        <Note text="three letters, then step" o={threeO} accent />
+      </>
+    );
+  }
+
+  if (phase === 'adapter') {
+    const codon = codons[1] ?? 'GCU';
+    const codonO = ease(remap(p, 0.04, 0.18, 0, 1));
+    const advO = ease(remap(p, 0.26, 0.42, 0, 1));
+    const rotO = ease(remap(p, 0.48, 0.60, 0, 1));
+    const cargoO = ease(remap(p, 0.66, 0.76, 0, 1));
+    const rackO = ease(remap(p, 0.82, 0.94, 0, 1));
+    const ax = cx - 93 + (1 - rotO) * 250;
+    inner = (
+      <>
+        <Tape tape={tape} reveal={1} accentRange={rotO > 0.5 ? [3, 5] : undefined} />
+        <Window startIdx={3} n={3} tapeLen={tape.length} o={codonO} accent={rotO > 0.5} label={`codon ${codon}`} />
+        {[0, 1, 2].map((i) => (
+          <Adapter key={i} x={cx + 230 + i * 195} y={344} codon={codons[(i + 2) % codons.length] ?? 'GAU'} o={rackO * 0.30} />
+        ))}
+        <Adapter x={ax} y={330} codon={codon} o={advO} accent={cargoO > 0.4} />
+        <Note text="anticodon end · amino-acid end" o={advO} y={224} />
+        <Note text="the dictionary is a drawer of two-ended adapters" o={rackO} y={SAFE.b - 120} />
+      </>
+    );
+  }
+
+  if (phase === 'cycle') {
+    const slotsO = ease(remap(p, 0.04, 0.16, 0, 1));
+    const badO = remap(p, 0.22, 0.28, 0, 1) * (1 - remap(p, 0.36, 0.42, 0, 1));
+    const badX = cx + 120 + remap(p, 0.30, 0.42, 0, 220);
+    const goodO = ease(remap(p, 0.40, 0.52, 0, 1));
+    const pHi = remap(p, 0.56, 0.64, 0, 1) * (1 - remap(p, 0.72, 0.78, 0, 1));
+    const bond = ease(remap(p, 0.70, 0.84, 0, 1));
+    const eject = ease(remap(p, 0.86, 0.99, 0, 1));
+    const aSlotX = cx + BODY_W / 6;
+    inner = (
+      <>
+        <Tape tape={tape} reveal={1} accentRange={goodO > 0.6 ? [6, 8] : undefined} />
+        <Body centerX={cx} o={1} slots />
+        <Chain aas={aas} grown={0.34} centerX={cx - 120} />
+        <Adapter x={badX} y={300} codon={codons[4] ?? 'CCG'} o={badO} />
+        <Note text="wrong anticodon — rejected" o={badO} y={224} />
+        <Adapter x={aSlotX - 93} y={300 + (1 - goodO) * 120} codon={codons[2] ?? 'UCA'} o={goodO} accent={goodO > 0.8} />
+        <Note text="match — it docks in A" o={goodO * (1 - bond)} y={224} accent />
+        <div style={{
+          position: 'absolute', left: cx - BODY_W / 6 - 40, top: BODY_TOP + 96, width: 80, height: 80,
+          borderRadius: 40, border: `3px solid ${CLAUDE.SPARK}`, opacity: pHi,
+        }} />
+        <Note text="the bond forms — the chain moves to the newcomer" o={bond} y={224} accent />
+        <Adapter x={cx - BODY_W / 2 - 40 - eject * 260} y={300 + eject * 60} codon={codons[1] ?? 'GCU'} o={eject * (1 - eject * 0.3)} spent />
+        <Note text="spent adapter leaves through E" o={eject} y={SAFE.b - 120} />
+      </>
+    );
+  }
+
+  if (phase === 'translocate') {
+    const stepN = Math.floor(remap(p, 0.06, 0.30, 0, 1.999));
+    const ghosts = remap(p, 0.32, 0.40, 0, 1) * (1 - remap(p, 0.52, 0.58, 0, 1));
+    const lock = ease(remap(p, 0.54, 0.66, 0, 1));
+    const grow = remap(p, 0.68, 0.90, 0.3, 1);
+    const fold = ease(remap(p, 0.90, 1.0, 0, 1));
+    const shift = stepN * 3 * CELL;
+    inner = (
+      <>
+        <Tape tape={tape} reveal={1} accentRange={[stepN * 3, stepN * 3 + 2]} />
+        <Body centerX={cx + shift - 3 * CELL} o={1} slots />
+        <Window startIdx={stepN * 3} n={3} tapeLen={tape.length} o={lock} accent label="still in register" />
+        <Note text={`+3   step ${stepN + 1}`} o={1} y={200} accent />
+        <Note text="+2" o={ghosts} y={272} strike />
+        <Note text="+4" o={ghosts} y={324} strike />
+        <Chain aas={aas} grown={grow} centerX={cx - 150} folded={fold} />
+      </>
+    );
+  }
+
+  if (phase === 'startstop') {
+    const augO = ease(remap(p, 0.04, 0.18, 0, 1));
+    const metO = ease(remap(p, 0.24, 0.34, 0, 1));
+    const moveP = ease(remap(p, 0.40, 0.52, 0, 1));
+    const failO = remap(p, 0.58, 0.66, 0, 1) * (1 - remap(p, 0.76, 0.82, 0, 1));
+    const rfO = ease(remap(p, 0.80, 0.90, 0, 1));
+    const freeO = ease(remap(p, 0.92, 1.0, 0, 1));
+    const stopIdx = (codons.length - 1) * 3;
+    const bodyX = cx - 6 * CELL + moveP * 6 * CELL;
+    inner = (
+      <>
+        <Tape tape={tape} reveal={1} accentRange={moveP < 0.5 ? [0, 2] : [stopIdx, stopIdx + 2]} />
+        <Body centerX={bodyX} o={1} slots emptyA={failO + rfO} />
+        <Window startIdx={0} n={3} tapeLen={tape.length} o={augO * (1 - moveP)} accent label="AUG — sets the frame" />
+        <Chain aas={['M']} grown={metO * (1 - moveP)} centerX={cx - 6 * CELL} />
+        <Note text="AUG starts it — methionine first" o={augO * (1 - moveP)} y={224} />
+        <Window startIdx={stopIdx} n={3} tapeLen={tape.length} o={moveP} accent label="UAG — no adapter exists" />
+        <Adapter x={bodyX + 200} y={300 - failO * 30} codon={codons[3] ?? 'GAU'} o={failO * 0.45} />
+        <Note text="nothing matches a stop codon" o={failO} y={224} accent />
+        <div style={{
+          position: 'absolute', left: bodyX + BODY_W / 6 - 90, top: 300, width: 180, height: 96,
+          border: `3px dashed ${CLAUDE.SPARK}`, borderRadius: 14, opacity: rfO,
+          display: 'flex', alignItems: 'center', justifyContent: 'center',
+          fontFamily: SANS, fontSize: 24, fontWeight: 700, color: CLAUDE.SPARK,
+        }}>release factor</div>
+        <Chain aas={aas} grown={moveP} centerX={cx - 150 + freeO * 40} folded={freeO} />
+        <Note text="the finished chain is cut loose" o={freeO} y={SAFE.b - 120} />
+      </>
+    );
+  }
+
+  return <IlluStage spark={spark} sparkPos="top">{inner}<BrandBug label={folderLabel} /></IlluStage>;
+};
+
+/* ==================================================================== *
+ * CodonTable — 64 spellings collapsing into 21 meanings.                *
+ * -------------------------------------------------------------------- *
+ * WHEN: the beat is about the SHAPE of the genetic code (redundancy).   *
+ * The grid is the real table; the cluster counts are counted from it,   *
+ * never asserted — REBUILD LAW (only numbers verifiable in the source). *
+ * ==================================================================== */
+export const CodonTable: React.FC<{ spark?: string; caption?: string; folderLabel?: string }> =
+  ({ spark = '', caption, folderLabel }) => {
+    const p = useP();
+    const codons = Object.keys(CODON_TABLE);
+    const groups = React.useMemo(() => {
+      const m: Record<string, string[]> = {};
+      for (const c of codons) (m[CODON_TABLE[c]] ??= []).push(c);
+      return Object.entries(m).sort((a, b) => b[1].length - a[1].length);
+    }, []);
+    const build = remap(p, 0.04, 0.40, 0, 1);
+    const merge = ease(remap(p, 0.56, 0.78, 0, 1));
+    const hiO = ease(remap(p, 0.86, 0.96, 0, 1));
+    const shown = Math.floor(build * 64);
+    const COLS = 8, CW = 138, CH = 74;
+    const gx0 = Math.round((1920 - COLS * CW) / 2), gy0 = 250;
+
+    return (
+      <IlluStage spark={spark} sparkPos="top">
+        {codons.map((c, i) => {
+          if (i >= shown) return null;
+          const r = Math.floor(i / COLS), q = i % COLS;
+          const gi = groups.findIndex(([aa]) => aa === CODON_TABLE[c]);
+          const gr = Math.floor(gi / 7), gq = gi % 7;
+          const tx = gx0 + q * CW, ty = gy0 + r * CH;
+          const mx = Math.round((1920 - 7 * 196) / 2) + gq * 196, my = 286 + gr * 152;
+          const x = tx + (mx - tx) * merge, y = ty + (my - ty) * merge;
+          const isHi = CODON_TABLE[c] === 'S';
+          return (
+            <div key={c} style={{
+              position: 'absolute', left: x, top: y, width: CW - 12, height: CH - 12,
+              display: 'flex', alignItems: 'center', justifyContent: 'center',
+              background: '#FFFFFF', borderRadius: 10,
+              border: `2px solid ${isHi && hiO > 0.5 ? CLAUDE.SPARK : CLAUDE.BORDER}`,
+              color: isHi && hiO > 0.5 ? CLAUDE.SPARK : CLAUDE.INK,
+              fontFamily: MONO, fontSize: 26, fontWeight: 600,
+              opacity: 1 - merge * 0.25,
+            }}>{c}</div>
+          );
+        })}
+        {groups.map(([aa, list], gi) => {
+          const gr = Math.floor(gi / 7), gq = gi % 7;
+          return (
+            <div key={aa} style={{
+              position: 'absolute', left: Math.round((1920 - 7 * 196) / 2) + gq * 196, top: 286 + gr * 152 + 76,
+              width: 184, textAlign: 'center', fontFamily: SANS, fontSize: 24, fontWeight: 700,
+              color: aa === 'S' && hiO > 0.5 ? CLAUDE.SPARK : CLAUDE.INK_SOFT, opacity: merge,
+            }}>{AA_NAME[aa]} ×{list.length}</div>
+          );
+        })}
+        <div style={{
+          position: 'absolute', left: SAFE.x, top: 150, width: SAFE.w, textAlign: 'center',
+          fontFamily: SERIF, fontSize: 76, color: CLAUDE.INK,
+        }}>{merge < 0.5 ? `${shown} codons` : `${groups.length} meanings`}</div>
+        {caption && (
+          <div style={{
+            position: 'absolute', left: SAFE.x, top: SAFE.b - 110, width: SAFE.w, textAlign: 'center',
+            fontFamily: SANS, fontSize: 32, color: CLAUDE.INK_SOFT, opacity: hiO,
+          }}>{caption}</div>
+        )}
+        <BrandBug label={folderLabel} />
+      </IlluStage>
+    );
+  };
+
+/* ==================================================================== *
+ * ReadingFrame — the falsifiability beat: delete one base, watch every  *
+ *   downstream word change while upstream words stay identical.         *
+ * -------------------------------------------------------------------- *
+ * PROPS: tape, deleteAt (0-based index of the base removed).            *
+ * The two readings are COMPUTED from CODON_TABLE, never typed by hand.  *
+ * ==================================================================== */
+export const ReadingFrame: React.FC<{
+  tape?: string; deleteAt?: number; spark?: string; folderLabel?: string;
+}> = ({ tape = 'AUGGCUUCAGAUCCGAAUUAG', deleteAt = 7, spark = '', folderLabel }) => {
+    const p = useP();
+    const shifted = tape.slice(0, deleteAt) + tape.slice(deleteAt + 1);
+    const readOf = (s: string) => {
+      const out: string[] = [];
+      for (const c of triplets(s)) { out.push(CODON_TABLE[c]); if (CODON_TABLE[c] === '*') break; }
+      return out;
+    };
+    const intact = readOf(tape), broken = readOf(shifted);
+    const survives = Math.floor(deleteAt / 3);
+
+    const topO = ease(remap(p, 0.02, 0.16, 0, 1));
+    const predO = ease(remap(p, 0.26, 0.38, 0, 1));
+    const cutO = ease(remap(p, 0.44, 0.52, 0, 1));
+    const slideO = ease(remap(p, 0.60, 0.74, 0, 1));
+    const garbleO = ease(remap(p, 0.78, 0.90, 0, 1));
+    const stopO = ease(remap(p, 0.92, 1.0, 0, 1));
+
+    const row = (seq: string, y: number, o: number, cutIdx: number | null, dimFrom: number | null) => {
+      const x0 = tapeStartX(seq.length);
+      return seq.split('').map((ch, i) => (
+        <div key={i} style={{
+          position: 'absolute', left: x0 + i * CELL, top: y, width: CELL, textAlign: 'center',
+          fontFamily: MONO, fontSize: 44, fontWeight: 600, opacity: o * (dimFrom !== null && i >= dimFrom ? 0.34 : 1),
+          color: cutIdx === i ? CLAUDE.SPARK : CLAUDE.INK,
+          textDecoration: cutIdx === i ? 'line-through' : 'none',
+        }}>{ch}</div>
+      ));
+    };
+    const words = (aas: string[], y: number, o: number, splitAt: number, accentAfter: boolean) =>
+      aas.map((a, i) => (
+        <div key={i} style={{
+          position: 'absolute', left: tapeStartX(aas.length * 3) + i * CELL * 3, top: y,
+          width: CELL * 3, textAlign: 'center', fontFamily: SANS, fontSize: 30, fontWeight: 700,
+          opacity: o, color: accentAfter && i >= splitAt ? CLAUDE.SPARK : CLAUDE.INK_SOFT,
+        }}>{AA_NAME[a]}</div>
+      ));
+
+    return (
+      <IlluStage spark={spark} sparkPos="top">
+        <div style={{
+          position: 'absolute', left: SAFE.x, top: 150, width: SAFE.w, textAlign: 'center',
+          fontFamily: SERIF, fontSize: 46, color: CLAUDE.INK, opacity: topO,
+        }}>the intact frame</div>
+        {row(tape, 226, topO, cutO > 0.4 ? deleteAt : null, null)}
+        {words(intact, 300, topO, 99, false)}
+
+        <div style={{
+          position: 'absolute', left: SAFE.x, top: 420, width: SAFE.w, textAlign: 'center',
+          fontFamily: SANS, fontSize: 34, color: CLAUDE.INK_SOFT, opacity: predO,
+        }}>prediction: remove one base and every word AFTER it changes</div>
+
+        <div style={{
+          position: 'absolute', left: SAFE.x, top: 540, width: SAFE.w, textAlign: 'center',
+          fontFamily: SERIF, fontSize: 46, color: CLAUDE.INK, opacity: slideO,
+        }}>the shifted frame</div>
+        {row(shifted, 616, slideO, null, garbleO > 0.4 ? survives * 3 : null)}
+        {words(broken, 690, garbleO, survives, true)}
+
+        <div style={{
+          position: 'absolute', left: SAFE.x, top: 800, width: SAFE.w, textAlign: 'center',
+          fontFamily: SANS, fontSize: 32, color: CLAUDE.INK, opacity: garbleO,
+        }}>
+          {intact.slice(0, survives).map((a) => AA_NAME[a]).join(' · ')} survive — everything after belongs to another protein
+        </div>
+        <div style={{
+          position: 'absolute', left: SAFE.x, top: SAFE.b - 110, width: SAFE.w, textAlign: 'center',
+          fontFamily: SANS, fontSize: 36, fontWeight: 700, color: CLAUDE.SPARK, opacity: stopO,
+        }}>a premature STOP appears at codon {broken.length}</div>
+        <BrandBug label={folderLabel} />
+      </IlluStage>
+    );
+  };
+
+/* ==================================================================== *
+ * LayerStackBeat — props-driven wrapper around the STRUCTURAL          *
+ *   LayerStack so a reel beat can use it directly.                     *
+ * -------------------------------------------------------------------- *
+ * GATE L returned LayerStack as a genuine HIT for the verdict beat     *
+ * (it enumerates the parts of a judgement), so this reel reuses it     *
+ * rather than building a fourth component. This wrapper only adds the  *
+ * stage, the spark line and the brand bug — the motion math is the     *
+ * library's, untouched, per the starter-template contract.             *
+ * ==================================================================== */
+export const LayerStackBeat: React.FC<{
+  layers: Layer[]; caption?: string; spark?: string; folderLabel?: string;
+}> = ({ layers, caption, spark = '', folderLabel }) => (
+  <IlluStage spark={spark} sparkPos="top">
+    <LayerStack layers={layers} caption={caption} />
+    <BrandBug label={folderLabel} />
+  </IlluStage>
+);
