+/**
+ * illustrations/pretraining.tsx — the PRETRAINING illustration family.
+ *
+ * Built for youtube/brutalist/week-01-video (INFO 7375, Week 01) after GATE L
+ * returned a genuine miss for "probability distribution over next token /
+ * training loss converging to corpus frequency".
+ *
+ * TWO RULES THIS FILE KEEPS
+ * -------------------------
+ * 1. Every number is measured. TRAJ (pretraining_trajectory.ts) is generated
+ *    from code/trajectory.json — all 601 steps of the real run. Bars, readouts
+ *    and the loss curve read TRAJ rows directly. When the animation moves
+ *    between two steps, BAR HEIGHTS ease between adjacent real rows, but every
+ *    DIGIT shown is a real row, never an interpolated value.
+ * 2. Every reveal lands on the spoken word. Beats receive props.cues — the
+ *    fraction of the beat at which each trigger word is spoken, computed from
+ *    mp3/words.json (align.py / faster-whisper) with a short lead-in. The first
+ *    cut used evenly spaced fractions; by B02's fourth step the picture trailed
+ *    the voice by 2.56s. The numbers passed as fallbacks below are used only if
+ *    a beat is rendered without cues.
+ *
+ * 1920×1080 native, positioned from SAFE. One terracotta accent per beat.
+ */
+import React from 'react';
+import { AbsoluteFill, useVideoConfig } from 'remotion';
+import { ClaudeComposerAsk } from '../scenes/ClaudeComposerAsk';
+import { CLAUDE } from '../tokens/claude';
+import { SAFE } from '../tokens/layout';
+import { SERIF, SANS, MONO, clamp, remap, ease, useP, IlluStage } from './kit';
+import { BrandBug } from './molecular';
+import { TRAJ, ENTROPY } from './pretraining_trajectory';
+
+export const TOKENS = ['sydney', 'canberra', 'melbourne'] as const;
+export const TRUTH_IDX = 1;
+export const CORPUS_FREQ = [0.70, 0.30, 0.00];
+export const GAP_CORPUS = 0.0022;   // code/OUTPUT.txt: max gap from CORPUS FREQUENCY
+export const GAP_TRUTH = 0.7011;    // code/OUTPUT.txt: max gap from TRUTH
+const MILESTONES = [0, 1, 5, 20, 100, 600];
+const SRC = 'code/OUTPUT.txt';
+
+type Cues = Record<string, number>;
+type Common = { spark?: string; folderLabel?: string; cues?: Cues };
+
+/* ── timing helpers ───────────────────────────────────────────────────── */
+const useDur = () => { const { durationInFrames, fps } = useVideoConfig(); return durationInFrames / fps; };
+/** reveal curve: 0 → 1 over `secs` seconds, starting at beat fraction t */
+const useReveal = () => {
+  const p = useP(); const dur = useDur();
+  return (t: number, secs = 0.5) => ease(remap(p, t, t + secs / dur, 0, 1));
+};
+const cueOf = (cues: Cues | undefined) => (k: string, d: number) =>
+  cues && typeof cues[k] === 'number' ? cues[k] : d;
+const logX = (s: number, x0: number, w: number) => x0 + (Math.log10(s + 1) / Math.log10(601)) * w;
+
+/* ── shared parts ─────────────────────────────────────────────────────── */
+const Center: React.FC<{ y: number; o?: number; size?: number; font?: string; color?: string; weight?: number; children: React.ReactNode }> =
+  ({ y, o = 1, size = 32, font = SANS, color = CLAUDE.INK_SOFT, weight = 400, children }) => (
+    <div style={{ position: 'absolute', left: SAFE.x, top: y, width: SAFE.w, textAlign: 'center',
+      fontFamily: font, fontSize: size, color, fontWeight: weight, opacity: o }}>{children}</div>
+  );
+
+const Src: React.FC<{ o?: number }> = ({ o = 1 }) => (
+  // Two short lines, not one long one: captions (max 46 chars) never reach left of x~585, and a
+  // single 54-char line ran to x~700 — under the caption box (QC 2026-09-27, B04). This is ~440px.
+  <div style={{ position: 'absolute', left: SAFE.x, bottom: 1080 - SAFE.b, fontFamily: MONO,
+    fontSize: 20, lineHeight: 1.25, color: CLAUDE.INK_SOFT, opacity: 0.75 * o }}>
+    <div>computed from the CONSTRUCTED corpus</div><div>source: {SRC}</div></div>
+);
+
+const ConstructedTag: React.FC<{ o?: number }> = ({ o = 1 }) => (
+  <div style={{
+    // top:120, not 66 — the spark line sits at top:44 in 40px serif and runs to ~y100.
+    position: 'absolute', left: SAFE.x, top: 120, padding: '8px 18px',
+    border: `2px solid ${CLAUDE.SPARK}`, borderRadius: 8, opacity: o,
+    fontFamily: SANS, fontSize: 22, fontWeight: 700, color: CLAUDE.SPARK, letterSpacing: 1,
+  }}>CONSTRUCTED — corpus invented for this demo, not real web text</div>
+);
+
+/** A real TRAJ row at a (possibly fractional) step: heights ease between rows, digits stay integral. */
+const rowAt = (s: number) => {
+  const a = clamp(Math.floor(s), 0, TRAJ.length - 1), b = clamp(a + 1, 0, TRAJ.length - 1), f = s - a;
+  const A = TRAJ[a], B = TRAJ[b];
+  return { step: Math.round(s), smooth: [0, 1, 2].map((i) => A[i] + (B[i] - A[i]) * f),
+           shown: TRAJ[clamp(Math.round(s), 0, TRAJ.length - 1)] };
+};
+
+/* ==================================================================== *
+ * TrainingLoop (B02) — the four steps, each lighting on its spoken verb *
+ * ==================================================================== */
+export const TrainingLoop: React.FC<Common> = ({ spark = '', folderLabel, cues }) => {
+  const c = cueOf(cues); const rv = useReveal(); const p = useP();
+  const steps = [
+    { k: 'step1', n: '1', t: 'take a passage of text', d: '"the capital of australia is ___"' },
+    { k: 'step2', n: '2', t: 'hide the next token', d: 'the answer is covered' },
+    { k: 'step3', n: '3', t: 'ask for its distribution', d: 'one probability per token' },
+    { k: 'step4', n: '4', t: 'compare with what followed', d: 'the corpus token is the target' },
+  ];
+  const fb = [0.10, 0.20, 0.28, 0.40];
+  const nudgeT = c('nudge', 0.60);
+  const nudge = rv(nudgeT, 0.8);
+  const noCheck = rv(c('nocheck', 0.85));
+  return (
+    <IlluStage spark={spark} sparkPos="top">
+      <Center y={140} size={60} font={SERIF} color={CLAUDE.INK}>the pretraining loop</Center>
+      {steps.map((s, i) => {
+        const t = c(s.k, fb[i]); const o = rv(t);
+        const next = i < 3 ? c(steps[i + 1].k, fb[i + 1]) : nudgeT;
+        const active = p >= t && p < next;           // the step being spoken right now
+        return (
+          <div key={i} style={{
+            position: 'absolute', left: SAFE.x + 30 + i * 430, top: 250 + (1 - o) * 30, width: 390, opacity: o,
+            background: '#FFFFFF', border: `1px solid ${CLAUDE.BORDER}`,
+            borderTop: `8px solid ${active ? CLAUDE.SPARK : CLAUDE.INK}`, borderRadius: 14,
+            padding: '24px 26px', minHeight: 300,
+            boxShadow: active ? '0 14px 36px rgba(217,119,87,0.22)' : '0 8px 24px rgba(61,57,41,0.08)',
+            transform: `scale(${active ? 1.03 : 1})`,
+          }}>
+            <div style={{ fontFamily: SANS, fontSize: 24, color: active ? CLAUDE.SPARK : CLAUDE.INK_SOFT }}>step {s.n}</div>
+            <div style={{ fontFamily: SERIF, fontSize: 42, color: CLAUDE.INK, marginTop: 12, lineHeight: 1.15 }}>{s.t}</div>
+            <div style={{ fontFamily: MONO, fontSize: 23, color: CLAUDE.INK_SOFT, marginTop: 20, lineHeight: 1.45 }}>{s.d}</div>
+          </div>
+        );
+      })}
+      <div style={{ position: 'absolute', left: SAFE.x + 30, top: 670, height: 3, background: CLAUDE.SPARK, width: 1690 * nudge }} />
+      <Center y={694} o={nudge} size={32} color={CLAUDE.SPARK}>
+        nudge every parameter so the token that followed gets more probability
+      </Center>
+      <Center y={780} o={noCheck * 0.5} size={50} font={SERIF}>
+        <span style={{ textDecoration: 'line-through' }}>step 5 — check whether it is true</span>
+      </Center>
+      <Center y={858} o={noCheck} size={40} color={CLAUDE.SPARK}>there is no step 5</Center>
+      <BrandBug label={folderLabel} />
+    </IlluStage>
+  );
+};
+
+/* ==================================================================== *
+ * CorpusCard (B03) — the constructed corpus, each row on its word.      *
+ * ==================================================================== */
+export const CorpusCard: React.FC<Common> = ({ spark = '', folderLabel, cues }) => {
+  const c = cueOf(cues); const rv = useReveal(); const p = useP(); const dur = useDur();
+  const counts = [7, 3, 0];
+  const tag = rv(c('tag', 0.18)), ctx = rv(c('ctx', 0.46)), freq = rv(c('freq', 0.93));
+  const rowK = ['r0', 'r1', 'r2'], rowF = [0.60, 0.72, 0.87];
+  return (
+    <IlluStage spark={spark} sparkPos="top">
+      <ConstructedTag o={tag} />
+      <Center y={214} o={ctx} size={44} font={MONO} color={CLAUDE.INK}>"the capital of australia is ___"</Center>
+      {TOKENS.map((tok, i) => {
+        const t = c(rowK[i], rowF[i]); const o = rv(t);
+        const isTruth = i === TRUTH_IDX; const y = 330 + i * 150;
+        return (
+          <React.Fragment key={tok}>
+            <div style={{ position: 'absolute', left: SAFE.x + 120, top: y, width: 300, opacity: o,
+              fontFamily: MONO, fontSize: 40, fontWeight: 600, color: CLAUDE.INK }}>{tok}</div>
+            {Array.from({ length: counts[i] }).map((_, k) => {
+              // tallies stack in one after another, each popping into place
+              const tk = ease(remap(p, t + (k * 0.11) / dur, t + (k * 0.11 + 0.25) / dur, 0, 1));
+              return <div key={k} style={{
+                position: 'absolute', left: SAFE.x + 470 + k * 58, top: y - 6 + (1 - tk) * 20,
+                width: 34, height: 54, borderRadius: 6, opacity: tk,
+                background: isTruth ? CLAUDE.INK : CLAUDE.SPARK, transform: `scale(${0.7 + 0.3 * tk})`,
+              }} />;
+            })}
+            {counts[i] === 0 && (
+              <div style={{ position: 'absolute', left: SAFE.x + 470, top: y, opacity: o,
+                fontFamily: SANS, fontSize: 30, color: CLAUDE.INK_SOFT }}>never follows</div>
+            )}
+            {isTruth && (
+              <div style={{ position: 'absolute', left: SAFE.x + 1180, top: y - 2, opacity: o,
+                fontFamily: SANS, fontSize: 26, fontWeight: 700, color: CLAUDE.INK,
+                border: `2px solid ${CLAUDE.INK}`, borderRadius: 8, padding: '4px 14px' }}>TRUE — the actual capital</div>
+            )}
+          </React.Fragment>
+        );
+      })}
+      <Center y={806} o={freq} size={36}>corpus frequency   sydney 0.70   ·   canberra 0.30   ·   melbourne 0.00</Center>
+      <Center y={862} o={freq} size={32} color={CLAUDE.SPARK}>the frequent continuation is the false one — on purpose</Center>
+      <BrandBug label={folderLabel} />
+    </IlluStage>
+  );
+};
+
+/* ==================================================================== *
+ * TokenBars (B04 start, B05 converge) — the distribution being fitted.  *
+ * ==================================================================== */
+const BASE = 812, MAXH = 470, BW = 230;
+const barX = (i: number) => 560 + i * (BW + 160);   // pitch 390: a corpus label (~130px) clears the next bar
+
+export const TokenBars: React.FC<Common & { phase: 'start' | 'converge' }> = ({ phase, spark = '', folderLabel, cues }) => {
+  const c = cueOf(cues); const rv = useReveal(); const p = useP();
+
+  // ── the step schedule: each milestone lands on the word that names it ──
+  let s = 0;
+  if (phase === 'converge') {
+    const keys: [number, number][] = [
+      [0, 0], [c('step1', 0.07), 1], [c('step5', 0.19), 5], [c('step20', 0.29), 20], [c('step600', 0.43), 600],
+    ];
+    for (let k = 0; k < keys.length - 1; k++) {
+      const [t0, s0] = keys[k], [t1, s1] = keys[k + 1];
+      if (p >= t0 && p < t1) {
+        const u = ease((p - t0) / Math.max(1e-6, t1 - t0));
+        s = Math.exp(Math.log(s0 + 1) + (Math.log(s1 + 1) - Math.log(s0 + 1)) * u) - 1;
+      } else if (p >= t1) s = s1;
+    }
+  }
+  const r = rowAt(s);
+  const grow = phase === 'start' ? rv(c('bars', 0.14), 0.8) : 1;
+  const valsO = phase === 'start' ? rv(c('vals', 0.28)) : 1;
+  const lossO = phase === 'start' ? rv(c('loss', 0.40)) : 1;
+  const lnO = phase === 'start' ? rv(c('ln', 0.60)) : 0;
+  const runO = phase === 'start' ? rv(c('run', 0.90)) : 0;
+  const targetsO = phase === 'converge' ? rv(c('step1', 0.07), 0.8) : 0;
+  const truthO = phase === 'converge' ? rv(c('nothing', 0.93), 0.6) : 0;
+  const lossHi = phase === 'converge' ? rv(c('lossword', 0.85), 0.4) : 0;
+  // which value the narrator is reading after "settles"
+  const readT = [c('read0', 0.52), c('read1', 0.62), c('read2', 0.71), c('lossword', 0.85)];
+  const reading = phase === 'converge' ? [0, 1, 2].findIndex((i) => p >= readT[i] && p < readT[i + 1]) : -1;
+
+  // left panel geometry: progress track + live loss sparkline
+  const TX = SAFE.x + 20, TW = 400;
+  const lossY = (l: number) => 930 - ((l - 0.6) / 0.5) * 130;   // loss 0.6..1.1 → y 930..800
+
+  return (
+    <IlluStage spark={spark} sparkPos="top">
+      <Center y={136} size={34} font={MONO}>"the capital of australia is ___"</Center>
+
+      <div style={{ position: 'absolute', left: TX, top: 246, fontFamily: SANS, fontSize: 28, color: CLAUDE.INK_SOFT }}>step</div>
+      <div style={{ position: 'absolute', left: TX, top: 280, fontFamily: MONO, fontSize: 96, fontWeight: 700, color: CLAUDE.INK }}>{r.step}</div>
+      <div style={{ position: 'absolute', left: TX, top: 408, width: TW, height: 4, background: CLAUDE.BORDER, borderRadius: 2 }} />
+      <div style={{ position: 'absolute', left: TX, top: 408, height: 4, borderRadius: 2, background: CLAUDE.INK, width: logX(s, 0, TW) }} />
+      {MILESTONES.map((m) => {
+        const hit = phase === 'converge' ? s >= m - 1e-6 : m === 0;
+        const x = logX(m, TX, TW);
+        const pop = phase === 'converge' && m > 0 && Math.abs(s - m) < Math.max(0.5, m * 0.06) ? 1 : 0;
+        return (
+          <React.Fragment key={m}>
+            <div style={{ position: 'absolute', left: x - 8, top: 402, width: 16, height: 16, borderRadius: 8,
+              background: hit ? CLAUDE.INK : CLAUDE.PAGE, border: `2px solid ${CLAUDE.INK}`,
+              transform: `scale(${1 + pop * 0.6})`, boxShadow: pop ? '0 0 16px rgba(217,119,87,0.6)' : 'none' }} />
+            <div style={{ position: 'absolute', left: x - 30, top: 426, width: 60, textAlign: 'center',
+              fontFamily: MONO, fontSize: 18, color: hit ? CLAUDE.INK : CLAUDE.INK_SOFT }}>{m}</div>
+          </React.Fragment>
+        );
+      })}
+      <div style={{ position: 'absolute', left: TX, top: 486, fontFamily: SANS, fontSize: 28, color: CLAUDE.INK_SOFT, opacity: lossO }}>loss</div>
+      <div style={{ position: 'absolute', left: TX, top: 520, fontFamily: MONO, fontSize: 72, fontWeight: 700, opacity: lossO,
+        color: lossHi > 0.5 ? CLAUDE.SPARK : CLAUDE.INK }}>{r.shown[3].toFixed(4)}</div>
+      {phase === 'start' && (
+        <>
+          <div style={{ position: 'absolute', left: TX, top: 612, fontFamily: SANS, fontSize: 30, color: CLAUDE.SPARK, opacity: lnO }}>= ln 3</div>
+          <div style={{ position: 'absolute', left: TX, top: 652, fontFamily: SANS, fontSize: 24, color: CLAUDE.INK_SOFT, opacity: lnO }}>uniform over three options</div>
+          <div style={{ position: 'absolute', left: TX, top: 740, padding: '10px 22px', borderRadius: 10, opacity: runO,
+            border: `2px solid ${CLAUDE.INK}`, fontFamily: SANS, fontSize: 30, color: CLAUDE.INK }}>run the loop  →</div>
+        </>
+      )}
+      {phase === 'converge' && (
+        <svg style={{ position: 'absolute', left: 0, top: 0 }} width={1920} height={1080}>
+          <line x1={TX} x2={TX + TW} y1={lossY(0.6109)} y2={lossY(0.6109)} stroke={CLAUDE.BORDER} strokeWidth={2} strokeDasharray="6 5" />
+          <polyline fill="none" stroke={lossHi > 0.5 ? CLAUDE.SPARK : CLAUDE.INK} strokeWidth={4} strokeLinejoin="round"
+            points={TRAJ.slice(0, Math.max(2, Math.floor(s) + 1)).map((row, k) =>
+              `${logX(k, TX, TW).toFixed(1)},${lossY(row[3]).toFixed(1)}`).join(' ')} />
+          <text x={TX} y={770} fontFamily={SANS} fontSize={20} fill={CLAUDE.INK_SOFT}>loss at every real step (log x)</text>
+        </svg>
+      )}
+
+      {TOKENS.map((tok, i) => {
+        const v = r.smooth[i] * grow; const h = v * MAXH; const x = barX(i);
+        const isTruth = i === TRUTH_IDX; const lead = i === 0 && phase === 'converge';
+        const glow = lead ? clamp((r.smooth[0] - 0.34) / 0.36, 0, 1) : 0;
+        const read = reading === i;
+        const ty = BASE - CORPUS_FREQ[i] * MAXH;
+        return (
+          <React.Fragment key={tok}>
+            {/* dashed corpus-frequency target the bar converges onto */}
+            <div style={{ position: 'absolute', left: x - 16, top: ty, width: BW + 32,
+              borderTop: `3px dashed ${CLAUDE.INK_SOFT}`, opacity: targetsO * 0.85 }} />
+            <div style={{ position: 'absolute', left: x + BW + 22, top: ty - 13, fontFamily: MONO, fontSize: 20,
+              color: CLAUDE.INK_SOFT, opacity: targetsO, whiteSpace: 'nowrap' }}>corpus {CORPUS_FREQ[i].toFixed(2)}</div>
+            {isTruth && (
+              <>
+                <div style={{ position: 'absolute', left: x, top: BASE - MAXH, width: BW, height: MAXH,
+                  border: `3px dotted ${CLAUDE.INK}`, borderRadius: '8px 8px 0 0', opacity: truthO * 0.6 }} />
+                <div style={{ position: 'absolute', left: x - 80, top: BASE - MAXH - 46, width: BW + 160, textAlign: 'center',
+                  fontFamily: SANS, fontSize: 24, color: CLAUDE.INK, opacity: truthO }}>if the target were truth: 1.00</div>
+              </>
+            )}
+            <div style={{
+              position: 'absolute', left: x, top: BASE - h, width: BW, height: Math.max(3, h),
+              background: isTruth ? CLAUDE.INK : CLAUDE.SPARK, borderRadius: '8px 8px 0 0',
+              opacity: isTruth ? 0.86 : 1,
+              boxShadow: glow > 0 ? `0 0 ${24 + 40 * glow}px rgba(217,119,87,${(0.25 + 0.35 * glow).toFixed(3)})` : 'none',
+            }} />
+            <div style={{
+              position: 'absolute', left: x - 30, top: BASE - h - 66, width: BW + 60, textAlign: 'center',
+              fontFamily: MONO, fontSize: 42, fontWeight: 700, opacity: valsO,
+              color: isTruth ? CLAUDE.INK : CLAUDE.SPARK,
+              transform: `scale(${read ? 1.18 : 1})`, textDecoration: read ? 'underline' : 'none',
+            }}>{r.shown[i].toFixed(4)}</div>
+            <div style={{ position: 'absolute', left: x - 30, top: BASE + 16, width: BW + 60, textAlign: 'center',
+              fontFamily: SANS, fontSize: 30, color: CLAUDE.INK }}>{tok}</div>
+            {isTruth && (
+              <div style={{ position: 'absolute', left: x - 30, top: BASE + 56, width: BW + 60, textAlign: 'center',
+                fontFamily: SANS, fontSize: 22, color: CLAUDE.INK_SOFT }}>TRUE</div>
+            )}
+          </React.Fragment>
+        );
+      })}
+      <div style={{ position: 'absolute', left: 530, top: BASE + 2, width: 1070, height: 2, background: CLAUDE.BORDER }} />
+      <Src />
+      <BrandBug label={folderLabel} />
+    </IlluStage>
+  );
+};
